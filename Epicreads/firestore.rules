rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin lookup can check if the user uid is registered in a special admins path
    // OR if their email is the bootstrapped developer's email: 'mainaann844@gmail.com'
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mainaann844@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    // 1. User profile shape validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'phoneNumber', 'email', 'createdAt'])
        && data.keys().size() == 5
        && data.uid is string && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20
        && data.email is string && data.email.size() <= 128
        && data.createdAt is string; // ISO string fallback or server timestamp
    }

    // 2. Book shape validation
    function isValidBook(data) {
      return data.keys().hasAll(['id', 'title', 'author', 'category', 'description', 'price', 'stockStatus', 'imageUrl', 'quantity'])
        && (data.keys().hasAny(['pdfPrice', 'pdfUrl']) ? true : true) // handles optional soft keys safely
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 150
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 50
        && data.description is string && data.description.size() <= 2000
        && data.price is int && data.price >= 0
        && (data.pdfPrice == null || (data.pdfPrice is int && data.pdfPrice >= 0))
        && (data.pdfUrl == null || (data.pdfUrl is string && data.pdfUrl.size() <= 500))
        && data.stockStatus in ['Available', 'Low Stock', 'Out of Stock']
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.quantity is int && data.quantity >= 0;
    }

    // 3. Order validation
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'phoneNumber', 'bookId', 'bookTitle', 'quantity', 'deliveryLocation', 'totalPrice', 'orderType', 'status', 'createdAt'])
        && (data.keys().hasAny(['userId', 'notes']) ? true : true)
        && data.id is string && data.id.size() <= 128
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20
        && data.bookId is string && data.bookId.size() <= 128
        && data.bookTitle is string && data.bookTitle.size() <= 200
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 100
        && data.deliveryLocation is string && data.deliveryLocation.size() >= 2 && data.deliveryLocation.size() <= 300
        && (data.notes == null || (data.notes is string && data.notes.size() <= 500))
        && data.totalPrice is int && data.totalPrice >= 0
        && data.orderType in ['Physical', 'PDF']
        && data.status in ['Pending', 'Processing', 'Delivered', 'Cancelled']
        && data.createdAt is string;
    }

    // 4. Reservation validation
    function isValidReservation(data) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'phoneNumber', 'bookId', 'bookTitle', 'expectedPurchaseDate', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20
        && data.bookId is string && data.bookId.size() <= 128
        && data.bookTitle is string && data.bookTitle.size() <= 200
        && data.expectedPurchaseDate is string
        && data.status in ['Pending', 'Approved', 'Completed', 'Cancelled']
        && data.createdAt is string;
    }

    // 5. Book Request validation
    function isValidBookRequest(data) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'phoneNumber', 'bookTitle', 'notes', 'status', 'createdAt'])
        && (data.keys().hasAny(['author']) ? true : true)
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20
        && data.bookTitle is string && data.bookTitle.size() <= 200
        && (data.author == null || (data.author is string && data.author.size() <= 150))
        && data.notes is string && data.notes.size() <= 1000
        && data.status in ['Sourcing', 'Available', 'Completed']
        && data.createdAt is string;
    }

    // 6. In-App Notification validation
    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'message', 'type', 'read', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.message is string && data.message.size() <= 500
        && data.type in ['order', 'reservation', 'request', 'status_update', 'general']
        && data.read is bool
        && data.createdAt is string;
    }

    // 7. Activity History validation
    function isValidActivity(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'actionDescription', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.actionDescription is string && data.actionDescription.size() <= 500
        && data.createdAt is string;
    }


    // --- Collections Routing Rules ---

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin(); // only James can query list of users
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        // Safeguard Role spoofing
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneNumber', 'email']) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Books Collection (Catalog space)
    match /books/{bookId} {
      allow read: if true; // anyone (even guests) can browse books
      allow create: if isAdmin() && isValidBook(incoming());
      allow update: if isAdmin() && isValidBook(incoming());
      allow delete: if isAdmin();
    }

    // 3. Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidOrder(incoming()) && (incoming().userId == null || isOwner(incoming().userId));
      allow update: if isAdmin() && isValidOrder(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    // 4. Reservations Collection
    match /reservations/{reservationId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidReservation(incoming());
      allow update: if (isAdmin() || (isSignedIn() && isOwner(existing().userId))) && isValidReservation(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    // 5. Book Requests Collection
    match /bookRequests/{requestId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidBookRequest(incoming());
      allow update: if isAdmin() && isValidBookRequest(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin();
    }

    // 6. Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'admin' && isAdmin());
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && (isOwner(existing().userId) || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isAdmin();
    }

    // 7. Activity Logs Collection (Admin only audit)
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn(); // Users log actions dynamically on viewing/ordering
      allow update, delete: if false; // Logs are immutable Audit records
    }

    // 8. Special admin access path helper (if storing custom admin profile details)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
